# En dev séparé, garde l'URL du serveur Express.
VITE_API_URL=http://localhost:4000
VITE_BASE_PATH=/

# En production sous /ktga avec serveur Express sur le même domaine:
# VITE_API_URL=
# VITE_BASE_PATH=/ktga/
#
# En production HTTPS sur netdis.org/ktga, utilise une API relative et un proxy serveur web:
# VITE_API_URL=
#
# En production avec backend HTTPS sur le sous-domaine API:
# VITE_API_URL=https://ktgapi.netdis.org:4000/ktga
#
# Optionnel si Socket.IO n'est pas exposé au même chemin que l'API:
# VITE_SOCKET_URL=https://ktgapi.netdis.org:4000
# VITE_SOCKET_PATH=/ktga/socket.io
