NODE_ENV=production
HOST=0.0.0.0
PORT=4000
APP_BASE_PATH=/ktga
CASINO_TIME_ZONE=Europe/Brussels

# Optionnel: active HTTPS directement dans le serveur Node.
# Les fichiers doivent être un certificat valide et sa clé privée.
# Pour un appel navigateur vers https://ktgapi.netdis.org:4000,
# le certificat doit être valide pour ktgapi.netdis.org.
# Avec Let's Encrypt sur Linux, les chemins ressemblent à:
# HTTPS_KEY_PATH=/etc/letsencrypt/live/ktgapi.netdis.org/privkey.pem
# HTTPS_CERT_PATH=/etc/letsencrypt/live/ktgapi.netdis.org/fullchain.pem
# Sur Windows avec scripts/setup-https-windows.ps1:
# HTTPS_KEY_PATH=./certs/ktgapi.netdis.org-key.pem
# HTTPS_CERT_PATH=./certs/ktgapi.netdis.org-chain.pem
# Si le port 80 est bloque, essaye:
# npm.cmd run cert:prod:windows -- -Domain ktgapi.netdis.org -ValidationMode tls-alpn-01
# Cette variante necessite le port 443 ouvert et libre pendant la validation.

# Obligatoire en production. Utilise une valeur longue, aléatoire et privée.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Limites HTTP basiques. Auth plus stricte pour limiter le brute force.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Nombre de proxys de confiance devant Node (par exemple 1 pour un reverse proxy local).
# Nécessaire pour que les limites et protections réseau utilisent l'adresse client réelle.
TRUST_PROXY=1

# Origines frontend autorisées, séparées par des virgules si besoin.
# Le serveur sera joignable sur https://ktgapi.netdis.org:4000/ktga si HTTPS est activé.
CLIENT_ORIGIN=http://netdis.org,https://netdis.org

# Adresse publique du client utilisée dans les liens de validation d'email.
PUBLIC_APP_URL=https://netdis.org/ktga

# Envoi des emails. Requis pour la récupération de mot de passe et lorsque la
# validation des comptes est activée. SMTP_USER et SMTP_PASS sont optionnels,
# mais doivent être fournis ensemble.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="KTGA.ME <no-reply@netdis.org>"
CONTACT_EMAIL=contact@netdis.org

# Chemin de la base SQLite. Prévois un volume persistant en production.
SQLITE_PATH=./data/ktga.sqlite

# Dossiers parentaux, activité agrégée et journal des récapitulatifs.
PARENTAL_DB_PATH=./data/parental.sqlite

# Signalements, dossiers, affectations et votes du tribunal des joueurs.
TRIBUNAL_DB_PATH=./data/tribunal.sqlite

# Messages globaux, directs et propres aux tables.
CHAT_DB_PATH=./data/chat.sqlite

# Historique public de disponibilite, consolide par tranches de 15 minutes.
STATUS_DB_PATH=./data/status.sqlite
STATUS_PROBE_INTERVAL_MS=60000

# Version suggeree lors de la creation d'une patchnote et stockage associe.
APP_VERSION=0.1.0
PATCHNOTES_DB_PATH=./data/patchnotes.sqlite
# Optional: defaults to SQLITE_PATH + ".help.sqlite". Back up its sibling help-images directory too.
HELP_DB_PATH=./data/help.sqlite
PATCHNOTES_UPLOAD_DIR=./data/patchnote-images

# Optionnel: sert le build React depuis Express.
# Exemple si tu copies client/dist dans server/public:
# CLIENT_DIST=./public
