NODE_ENV=production
# FULL preserves committed writes across power failures. NORMAL is optional in
# WAL mode, but can lose recent committed writes after a power/OS failure.
SQLITE_SYNCHRONOUS=FULL
HOST=127.0.0.1
PORT=4000
# Empty for api.ktga.me at root. Legacy /ktga deployments remain supported.
APP_BASE_PATH=
CASINO_TIME_ZONE=Europe/Brussels

# Nginx handles public HTTPS. Node uses HTTP on loopback only.
TLS_TERMINATION=proxy
TRUST_PROXY=loopback
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
HTTPS_PFX_PATH=
# Direct HTTPS remains supported: clear TLS_TERMINATION and provide
# HTTPS_KEY_PATH + HTTPS_CERT_PATH, or HTTPS_PFX_PATH.

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

CLIENT_ORIGIN=https://www.ktga.me
PUBLIC_APP_URL=https://www.ktga.me

# Keep EMAIL_FROM aligned with the authenticated OVH mailbox.
# Contact destination is independently editable in the casino administration.
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="KTGA.ME <contact@netdis.org>"
CONTACT_EMAIL=contact@netdis.org

# VPS paths are absolute under /var/lib/ktga; see deploy/debian.
SQLITE_PATH=./data/ktga.sqlite
PARENTAL_DB_PATH=./data/parental.sqlite
TRIBUNAL_DB_PATH=./data/tribunal.sqlite
CHAT_DB_PATH=./data/chat.sqlite
STATUS_DB_PATH=./data/status.sqlite
REQUEST_LOG_PATH=./data/request-logs.sqlite
PATCHNOTES_DB_PATH=./data/patchnotes.sqlite
PATCHNOTES_UPLOAD_DIR=./data/patchnote-images
# Keep historical filenames when migrating; do not rename them inadvertently.
HELP_DB_PATH=./data/ktga.sqlite.help.sqlite
DATA_REQUEST_DB_PATH=./data/ktga.sqlite.rights.sqlite
BUG_REPORT_DB_PATH=./data/ktga.sqlite.bugs.sqlite
BUG_REPORT_UPLOAD_DIR=./data/bug-images
CONTACT_NOTICE_DB_PATH=./data/ktga.sqlite.contact-notices.sqlite
RANK_INSIGNIA_UPLOAD_DIR=./data/rank-insignia-images
STATUS_PROBE_INTERVAL_MS=60000

# Leave blank when Nginx serves client/dist.
# Version comes from package.json unless APP_VERSION is explicitly set.
CLIENT_DIST=
# Experimental accounts process: enable only after capacity validation on the target.
ACCOUNTS_PROCESS_ENABLED=0
# Legacy read-only pool, used only with ACCOUNTS_PROCESS_ENABLED=0 (1-4 workers).
READING_WORKERS=1
# Defaults to execution.sqlite beside SQLITE_PATH; anonymous metrics, 30-day retention.
# EXECUTION_DB_PATH=/var/lib/ktga/execution.sqlite
