NODE_ENV=production
# Experimental: keep disabled until capacity validation on this VPS passes.
ACCOUNTS_PROCESS_ENABLED=0
HOST=127.0.0.1
PORT=4000
APP_BASE_PATH=
TLS_TERMINATION=proxy
TRUST_PROXY=loopback
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
HTTPS_PFX_PATH=
CASINO_TIME_ZONE=Europe/Brussels
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=https://www.ktga.me
PUBLIC_APP_URL=https://www.ktga.me
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Fill SMTP_HOST, SMTP_USER and SMTP_PASS before opening registrations.
# OVH: SMTP_HOST=smtp.mail.ovh.net, port 465, TLS enabled.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="KTGA.ME <contact@netdis.org>"
CONTACT_EMAIL=contact@netdis.org

SQLITE_PATH=/var/lib/ktga/ktga.sqlite
PARENTAL_DB_PATH=/var/lib/ktga/parental.sqlite
TRIBUNAL_DB_PATH=/var/lib/ktga/tribunal.sqlite
CHAT_DB_PATH=/var/lib/ktga/chat.sqlite
STATUS_DB_PATH=/var/lib/ktga/status.sqlite
REQUEST_LOG_PATH=/var/lib/ktga/request-logs.sqlite
PATCHNOTES_DB_PATH=/var/lib/ktga/patchnotes.sqlite
HELP_DB_PATH=/var/lib/ktga/ktga.sqlite.help.sqlite
DATA_REQUEST_DB_PATH=/var/lib/ktga/ktga.sqlite.rights.sqlite
BUG_REPORT_DB_PATH=/var/lib/ktga/ktga.sqlite.bugs.sqlite
CONTACT_NOTICE_DB_PATH=/var/lib/ktga/ktga.sqlite.contact-notices.sqlite
PATCHNOTES_UPLOAD_DIR=/var/lib/ktga/patchnote-images
BUG_REPORT_UPLOAD_DIR=/var/lib/ktga/bug-images
RANK_INSIGNIA_UPLOAD_DIR=/var/lib/ktga/rank-insignia-images
STATUS_PROBE_INTERVAL_MS=60000
CLIENT_DIST=/var/www/ktga
